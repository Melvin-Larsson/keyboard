		)
		(uuid "62b8822b-864e-4fa1-94de-cd309061f38e")
	)
	(text "V_DPPM_SET = I_DPPM * R_DPPM\nV_DPPM_REG = V_DDP_SET * SF\nWill reduce charge current if below V_DPPM_SET * SF, I.e. V_DPPM_REG\nSF \\in [1.139, 1.162]. Typ 1.150\nI_DPPM_SET \\in [95, 105] uA\n\nIf we want V_DPPM_REG to be 4.26V we get R_DPPM = 37.4k\n\nWe choose V_DPPM_REG kinda high because losses in the system is (V_out - V_in) * I_Load,\n so we want V_out - Vin to be as small as possible.\nBut we keep some margin to the 5V from USB"
		(exclude_from_sim no)
		(at 146.812 155.956 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "6e7b2302-13ec-42b6-ab88-216ef0d44814")
	)
